{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http": "Warning",
      "Microsoft": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "SingleLine": true, "IncludeScopes": false }
    }
  },
  "Music": {
    "Providers": [ "itunes", "musicbrainz" ],
    "CacheDuration": "12:00:00",
    "Itunes": {
      "Timeout": "00:00:03",
      "PermitLimit": 20,
      "Window": "00:01:00"
    },
    "MusicBrainz": {
      "ApplicationName": "ReveilMusical",
      "ApplicationVersion": "1.0",
      "Contact": "reveil-musical@example.com",
      "Timeout": "00:00:03",
      "PermitLimit": 1,
      "Window": "00:00:01"
    }
  },
  "Notifications": {
    "Mocks": {
      "Outages": []
    }
  }
}
